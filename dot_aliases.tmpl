# Python
alias uvm="uv run python manage.py"

# Git
## Git log fzf with preview (made by dbessey)
alias glf="git log --oneline --graph --color=always --format='%h %s %C(blue)@%an%C(reset) %C(green)%cr%C(reset)' | fzf --ansi --preview 'git show --color \$(echo {} | cut -d\" \" -f1)'"

# VPN
alias unistra-vpn="sudo openfortivpn -c ~/.unistra/vpn.config"

# copy to clipboard
alias 2clip="xclip -selection clipboard"
